{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Airframe": {
    "Input": {
      "Protocol": "Udp",
      "Host": "0.0.0.0",
      "Port": 21000
    },
    "Outputs": [
      {
        "Types": [
          "Aero"
        ],
        "Protocol": "Udp",
        "Host": "feed.airframes.io",
        "Port": 5571
      },
      {
        "Types": [
          "Vdl2"
        ],
        "Protocol": "Udp",
        "Host": "feed.airframes.io",
        "Port": 5552
      },
      {
        "Types": [
          "Acars"
        ],
        "Protocol": "Udp",
        "Host": "feed.airframes.io",
        "Port": 5550
      },
      {
        "Types": [
          "Hfdl"
        ],
        "Protocol": "Tcp",
        "Host": "feed.airframes.io",
        "Port": 5556
      }
    ],
    "MongoDB": {
      "Enabled": false,
      "ConnectionString": "mongodb:///?compressors=snappy,zlib,zstd",
      "Database": "aviator",
      "Collection": "aviator"
    }
  },
  "Adsb": {
    "Enabled": false,
    "StatsPath": "C:/cryptic/test.txt"
  },
  "Metrics": {
    "InfluxDB": {
      "Enabled": false,
      "Url": "",
      "Bucket": "aviator",
      "Organization": "aviator",
      "Token": ""
    },
    "QuestDB": {
      "addr": "192.168.2.110:9000"
    }
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Debug"
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} {Level:u3}{Scope}] {Message:lj}{NewLine}{Exception}",
          "restrictedToMinimumLevel": "Information"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/aviator-log.txt",
          "rollingInterval": "Month",
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} {Level:u3}{Scope}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  }
}
