@using System.Globalization
@inject IJSRuntime JS
@inject DecoderRegistry DecoderRegistry

<div class="card acars-card">
    <div class="card-body p-3">
        <div class="acars-card-content d-flex gap-3 align-items-start">

            @* Aircraft photo — loaded by the browser directly from Planespotters CDN *@
            <div class="acars-photo flex-shrink-0">
                @if (_photo?.Url is not null)
                {
                    <a href="@_photo.Link" target="_blank" rel="noopener noreferrer" title="View on Planespotters.net">
                        <img src="@_photo.Url" alt="@Registration" class="rounded" loading="lazy" />
                    </a>
                    @if (!string.IsNullOrEmpty(_photo.Photographer))
                    {
                        <div class="photo-credit text-truncate" title="© @_photo.Photographer">
                            © @_photo.Photographer
                        </div>
                    }
                }
                else
                {
                    <div class="acars-photo-placeholder rounded d-flex align-items-center justify-content-center text-secondary">
                        <i class="bi bi-airplane fs-4"></i>
                    </div>
                }
            </div>

            @* Message body *@
            <div class="flex-grow-1 min-w-0">
                <div class="d-flex flex-wrap align-items-center gap-2 mb-1">
                    <span class="badge frame-badge-@Message.FrameType.ToString().ToLower()">@Message.FrameType</span>

                    @if (!string.IsNullOrEmpty(Registration))
                    {
                        <a class="fw-semibold text-decoration-none reg-link"
                           href="/aircraft/@Uri.EscapeDataString(Registration)">@Registration</a>
                    }
                    @if (!string.IsNullOrEmpty(Message.Icao) && Message.Icao != "0")
                    {
                        <span class="text-secondary font-monospace small">@Message.Icao.ToUpperInvariant()</span>
                    }
                    @if (!string.IsNullOrEmpty(FlightNumber))
                    {
                        <span class="flight-no" title="Flight number">@FlightNumber</span>
                    }
                    @if (!string.IsNullOrEmpty(Label))
                    {
                        <span class="badge bg-secondary" title="@(AcarsLabels.Describe(Label) ?? "Unknown label")">@Label</span>
                    }
                    @if (!string.IsNullOrEmpty(Message.Channel))
                    {
                        <span class="text-secondary small ms-auto">@ChannelFormat.Mhz(Message.Channel)</span>
                    }
                    <LocalTime Value="Message.Timestamp" Class="@(string.IsNullOrEmpty(Message.Channel) ? "text-secondary small ms-auto" : "text-secondary small")" />
                </div>

                @if (!string.IsNullOrWhiteSpace(Text))
                {
                    <pre class="acars-text mb-1">@Text</pre>
                }

                @* Decoded message panel *@
                @if (_decoded is not null)
                {
                    <DecodedMessageView Message="_decoded" />
                }

                @if (Message.Position is not null)
                {
                    <div class="d-flex align-items-center gap-2 mt-1">
                        <i class="bi bi-geo-alt text-info small"></i>
                        <a class="text-info small text-decoration-none"
                           href="@OsmUrl(Message.Position)"
                           target="_blank" rel="noopener noreferrer">
                            @Message.Position.Latitude.ToString("F4", CultureInfo.InvariantCulture)°, @Message.Position.Longitude.ToString("F4", CultureInfo.InvariantCulture)°
                        </a>
                        @if (Message.Position.Altitude > 0)
                        {
                            <span class="text-secondary small">@Message.Position.Altitude ft</span>
                        }
                        @if (!Message.Position.RealPosition)
                        {
                            <span class="badge bg-warning text-dark small">estimated</span>
                        }
                    </div>
                }

                @if (Message.SignalLevel.HasValue)
                {
                    <div class="text-secondary small mt-1">
                        <i class="bi bi-reception-4 me-1"></i>@Message.SignalLevel.Value.ToString("F1") dB
                        @if (Message.NoiseLevel.HasValue)
                        {
                            <span class="ms-2"><i class="bi bi-soundwave me-1"></i>@Message.NoiseLevel.Value.ToString("F1") dB</span>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public required Airframe Message { get; set; }

    private PhotoData? _photo;
    private IDecodedMessage? _decoded;
    private Airframe? _decodedFor;

    private Acars? Payload => Message.Protocol as Acars;
    private string Registration => Payload?.Registration ?? "";
    private string FlightNumber => Payload?.FlightNumber ?? "";
    private string Label => Payload?.Label ?? "";
    private string Text => Payload?.Text ?? "";

    private static string OsmUrl(Position p) => FormattableString.Invariant(
        $"https://www.openstreetmap.org/?mlat={p.Latitude}&mlon={p.Longitude}#map=9/{p.Latitude}/{p.Longitude}");

    private string? _photoReg;

    protected override async Task OnParametersSetAsync()
    {
        // The parent re-renders on every incoming frame; only decode once per message
        if (!ReferenceEquals(_decodedFor, Message))
        {
            _decodedFor = Message;
            _decoded = DecoderRegistry.TryDecode(Label, Text);
        }

        var reg = Registration;
        if (string.IsNullOrEmpty(reg) || reg == _photoReg) return;
        _photoReg = reg;
        try
        {
            _photo = await JS.InvokeAsync<PhotoData?>("fetchPlanespottersPhoto", reg);
        }
        catch (Exception e) when (e is InvalidOperationException or JSDisconnectedException or TaskCanceledException)
        {
            // JS unavailable (prerender / circuit gone) — photo stays null
        }
    }

    private sealed class PhotoData
    {
        public string? Url { get; set; }
        public string? Link { get; set; }
        public string? Photographer { get; set; }
    }
}
