@page "/aircraft/{Reg}"
@implements IAsyncDisposable
@inject IDbContextFactory<AviatorDbContext> DbFactory
@inject IJSRuntime JS
@inject DecoderRegistry DecoderRegistry

<PageTitle>@Reg — Aviator</PageTitle>

<div class="d-flex flex-column h-100 overflow-auto">

    @* ── Header ──────────────────────────────────────────────── *@
    <div class="d-flex flex-wrap align-items-center gap-2 px-3 py-2 border-bottom border-secondary-subtle">
        <a class="btn btn-sm btn-outline-secondary py-0" href="/acars" title="Back to live feed">
            <i class="bi bi-arrow-left"></i>
        </a>
        <h6 class="mb-0 fw-semibold">@Reg</h6>
        @if (!string.IsNullOrEmpty(_icaoHex))
        {
            <span class="text-secondary font-monospace small">@_icaoHex.ToUpperInvariant()</span>
        }
        @if (!string.IsNullOrEmpty(_lastFlight))
        {
            <span class="badge bg-secondary" title="Last seen flight number">@_lastFlight</span>
        }
        @foreach (var (type, count) in _frameTypes)
        {
            <span class="frame-badge-@type.ToLower()">@type @count.ToString("N0")</span>
        }
        @if (_loading)
        {
            <span class="spinner-border spinner-border-sm text-secondary ms-auto" role="status"></span>
        }
    </div>

    @if (!_loading && _totalMessages == 0)
    {
        <div class="d-flex flex-column align-items-center justify-content-center h-100 text-secondary">
            <i class="bi bi-airplane display-4 mb-3 opacity-50"></i>
            <p class="mb-0">No messages from <strong class="mx-1">@Reg</strong> in the database.</p>
        </div>
    }
    else if (_totalMessages > 0)
    {
        <div class="p-3 d-flex flex-column gap-3">

            @* ── Photo + summary ──────────────────────────────── *@
            <div class="row g-2">
                <div class="col-12 col-md-auto">
                    <div class="card stat-card border h-100 aircraft-photo-card">
                        @if (_photo?.Url is not null)
                        {
                            <a href="@_photo.Link" target="_blank" title="View on Planespotters.net">
                                <img src="@_photo.Url" alt="@Reg" class="rounded" loading="lazy" />
                            </a>
                            @if (!string.IsNullOrEmpty(_photo.Photographer))
                            {
                                <div class="photo-credit text-truncate w-100" title="© @_photo.Photographer">© @_photo.Photographer</div>
                            }
                        }
                        else
                        {
                            <div class="d-flex align-items-center justify-content-center h-100 text-secondary" style="min-height:120px;min-width:180px">
                                <i class="bi bi-airplane fs-1 opacity-50"></i>
                            </div>
                        }
                    </div>
                </div>
                <div class="col-6 col-md">
                    <div class="card stat-card border h-100">
                        <div class="card-body p-3">
                            <div class="text-secondary small mb-1">Messages</div>
                            <div class="fs-4 fw-bold" style="color:#58a6ff">@_totalMessages.ToString("N0")</div>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-md">
                    <div class="card stat-card border h-100">
                        <div class="card-body p-3">
                            <div class="text-secondary small mb-1">First Seen</div>
                            <div class="fw-semibold">@_firstSeen.ToLocalTime().ToString("yyyy-MM-dd")</div>
                            <div class="text-secondary" style="font-size:.72rem">@_firstSeen.ToLocalTime().ToString("HH:mm:ss")</div>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-md">
                    <div class="card stat-card border h-100">
                        <div class="card-body p-3">
                            <div class="text-secondary small mb-1">Last Seen</div>
                            <div class="fw-semibold">@_lastSeen.ToLocalTime().ToString("yyyy-MM-dd")</div>
                            <div class="text-secondary" style="font-size:.72rem">@_lastSeen.ToLocalTime().ToString("HH:mm:ss")</div>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-md">
                    <div class="card stat-card border h-100">
                        <div class="card-body p-3">
                            <div class="text-secondary small mb-1">Channels</div>
                            <div class="d-flex flex-wrap gap-1">
                                @foreach (var ch in _channels)
                                {
                                    <span class="small text-info font-monospace">@ch</span>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            @* ── Track map ────────────────────────────────────── *@
            @if (_track.Count > 0)
            {
                <div class="card stat-card border">
                    <div class="card-body p-2">
                        <p class="text-secondary fw-semibold mb-2 px-1" style="font-size:.7rem;letter-spacing:.08em;text-transform:uppercase">
                            Positions — @_track.Count point@(_track.Count == 1 ? "" : "s")
                        </p>
                        <div id="aircraft-track-map" class="aircraft-track-map rounded"></div>
                    </div>
                </div>
            }

            @* ── Recent messages ──────────────────────────────── *@
            <div class="card stat-card border">
                <div class="card-body p-3">
                    <p class="text-secondary fw-semibold mb-2" style="font-size:.7rem;letter-spacing:.08em;text-transform:uppercase">
                        Last @_messages.Count Messages
                    </p>
                    <div class="d-flex flex-column gap-2">
                        @foreach (var vm in _messages)
                        {
                            <div class="card acars-card border-secondary-subtle" @key="vm.Entity.Id">
                                <div class="card-body p-3">
                                    <div class="d-flex flex-wrap align-items-center gap-2 mb-1">
                                        <span class="badge frame-badge-@vm.Entity.FrameType.ToLower()">@vm.Entity.FrameType</span>
                                        @if (!string.IsNullOrEmpty(vm.Entity.AcarsLabel))
                                        {
                                            <span class="badge bg-secondary" title="@(AcarsLabels.Describe(vm.Entity.AcarsLabel) ?? "Unknown label")">@vm.Entity.AcarsLabel</span>
                                        }
                                        @if (!string.IsNullOrEmpty(vm.Entity.AcarsFlightNumber))
                                        {
                                            <span class="text-secondary small">@vm.Entity.AcarsFlightNumber</span>
                                        }
                                        @if (!string.IsNullOrEmpty(vm.Entity.Channel))
                                        {
                                            <span class="text-secondary small ms-auto">@vm.Entity.Channel MHz</span>
                                        }
                                        <span class="text-secondary small" title="@vm.Entity.Timestamp.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")">
                                            @vm.Entity.Timestamp.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")
                                        </span>
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(vm.Entity.AcarsText))
                                    {
                                        <pre class="acars-text mb-1">@vm.Entity.AcarsText</pre>
                                    }
                                    @if (vm.Decoded is not null)
                                    {
                                        <DecodedMessageView Message="vm.Decoded" />
                                    }
                                    @if (vm.Entity.SignalLevel.HasValue)
                                    {
                                        <div class="text-secondary small mt-1">
                                            <i class="bi bi-reception-4 me-1"></i>@vm.Entity.SignalLevel.Value.ToString("F1") dB
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>

        </div>
    }
</div>

@code {
    [Parameter] public string Reg { get; set; } = "";

    private const int MaxListedMessages = 50;
    private const int MaxTrackPoints = 500;

    private bool _loading = true;
    private string? _loadedReg;

    private int _totalMessages;
    private DateTimeOffset _firstSeen;
    private DateTimeOffset _lastSeen;
    private string? _icaoHex;
    private string? _lastFlight;
    private List<(string Type, int Count)> _frameTypes = [];
    private List<string> _channels = [];
    private List<TrackPt> _track = [];
    private List<MessageVm> _messages = [];
    private string _lastFrameType = "";

    private PhotoData? _photo;
    private bool _jsPending;

    protected override async Task OnParametersSetAsync()
    {
        if (Reg == _loadedReg) return;
        _loadedReg = Reg;

        _loading = true;
        try
        {
            await LoadAsync();
        }
        catch
        {
            // DB unavailable — page shows the empty state
        }
        finally
        {
            _loading = false;
            _jsPending = true;
        }
    }

    private async Task LoadAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var query = db.Airframes.Where(x => x.AcarsRegistration == Reg);

        _totalMessages = await query.CountAsync();
        if (_totalMessages == 0) return;

        _firstSeen = await query.MinAsync(x => x.Timestamp);
        _lastSeen  = await query.MaxAsync(x => x.Timestamp);

        _icaoHex = await query
            .Where(x => x.Icao != "" && x.Icao != "0")
            .OrderByDescending(x => x.Timestamp)
            .Select(x => x.Icao)
            .FirstOrDefaultAsync();

        _lastFlight = await query
            .Where(x => x.AcarsFlightNumber != null && x.AcarsFlightNumber != "")
            .OrderByDescending(x => x.Timestamp)
            .Select(x => x.AcarsFlightNumber)
            .FirstOrDefaultAsync();

        _frameTypes = (await query
            .GroupBy(x => x.FrameType)
            .Select(g => new { g.Key, Count = g.Count() })
            .OrderByDescending(x => x.Count)
            .ToListAsync())
            .Select(x => (x.Key, x.Count))
            .ToList();

        _channels = await query
            .Where(x => x.Channel != "")
            .GroupBy(x => x.Channel)
            .OrderByDescending(g => g.Count())
            .Take(6)
            .Select(g => g.Key)
            .ToListAsync();

        _track = (await query
            .Where(x => x.Latitude.HasValue && x.Longitude.HasValue && x.RealPosition == true)
            .OrderByDescending(x => x.Timestamp)
            .Take(MaxTrackPoints)
            .Select(x => new { x.Latitude, x.Longitude, x.Altitude, x.Timestamp })
            .ToListAsync())
            .OrderBy(x => x.Timestamp)
            .Select(x => new TrackPt(
                (double)x.Latitude!.Value,
                (double)x.Longitude!.Value,
                x.Altitude.HasValue ? (int)x.Altitude.Value : null,
                x.Timestamp))
            .ToList();

        var entities = await query
            .OrderByDescending(x => x.Timestamp)
            .Take(MaxListedMessages)
            .ToListAsync();

        _messages = entities
            .Select(e => new MessageVm(e, DecoderRegistry.TryDecode(e.AcarsLabel ?? "", e.AcarsText ?? "")))
            .ToList();

        _lastFrameType = _frameTypes.Count > 0 ? _frameTypes[0].Type : "";
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_jsPending) return;
        _jsPending = false;

        if (_track.Count > 0)
            await JS.InvokeVoidAsync("AviatorMap.showTrack", "aircraft-track-map", _track, _lastFrameType);

        if (_totalMessages > 0)
        {
            _photo = await JS.InvokeAsync<PhotoData?>("fetchPlanespottersPhoto", Reg);
            if (_photo is not null) StateHasChanged();
        }
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("AviatorMap.destroyTrack");
        }
        catch (JSDisconnectedException)
        {
            // Circuit already gone — nothing to clean up in the browser
        }
    }

    private sealed record TrackPt(double Lat, double Lon, int? AltFt, DateTimeOffset Ts);
    private sealed record MessageVm(AirframeEntity Entity, IDecodedMessage? Decoded);

    private sealed class PhotoData
    {
        public string? Url { get; set; }
        public string? Link { get; set; }
        public string? Photographer { get; set; }
    }
}
