@page "/map"
@implements IAsyncDisposable
@inject IJSRuntime JS

<PageTitle>Map — Aviator</PageTitle>

<div class="d-flex flex-column h-100">

    @* ── Header ──────────────────────────────────────────────── *@
    <div class="page-toolbar">
        <h6 class="mb-0 fw-semibold me-1">Map</h6>

        <div class="btn-group btn-group-sm" role="group" aria-label="Time range">
            @foreach (var q in Presets)
            {
                <button class="btn py-0 @(_rangeInput == q ? "btn-primary" : "btn-outline-secondary")"
                        @onclick="() => ApplyRangeAsync(q)">@q</button>
            }
        </div>

        <input class="form-control form-control-sm map-range-input"
               @bind="_rangeInput"
               @bind:event="oninput"
               @onkeyup="OnKeyUpAsync"
               placeholder="e.g. 6h, 2d"
               aria-label="Custom time range" />

        <button class="btn btn-sm btn-outline-secondary py-0"
                @onclick="ReloadAsync"
                title="Reload"
                disabled="@_loading">
            <i class="bi bi-arrow-clockwise @(_loading ? "spin" : "")"></i>
        </button>

        <div class="form-check form-switch mb-0 small" title="Reload every @AutoRefreshSeconds s">
            <input class="form-check-input" type="checkbox" role="switch" id="map-auto"
                   checked="@_autoRefresh" @onchange="ToggleAutoRefresh" />
            <label class="form-check-label text-secondary" for="map-auto">Auto</label>
        </div>

        @if (!string.IsNullOrEmpty(_status))
        {
            <span class="text-secondary small ms-1">@_status</span>
        }
    </div>

    @* ── Map container ────────────────────────────────────────── *@
    <div id="av-map" class="flex-grow-1 map-container"></div>

</div>

@code {
    private string _rangeInput = "1h";
    private string _status     = "";
    private bool   _loading;
    private bool   _initialized;
    private bool   _autoRefresh;
    private PeriodicTimer? _timer;
    private CancellationTokenSource? _timerCts;

    private static readonly string[] Presets = ["1h", "6h", "12h", "1d", "3d"];
    private const int AutoRefreshSeconds = 60;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        await JS.InvokeVoidAsync("AviatorMap.init", "av-map");
        _initialized = true;
        await ReloadAsync();
    }

    private async Task ApplyRangeAsync(string range)
    {
        _rangeInput = range;
        await ReloadAsync();
    }

    private async Task OnKeyUpAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await ReloadAsync();
    }

    private void ToggleAutoRefresh(ChangeEventArgs e)
    {
        _autoRefresh = e.Value is true;
        StopTimer();
        if (_autoRefresh) _ = RunTimerAsync();
    }

    private async Task RunTimerAsync()
    {
        _timerCts = new CancellationTokenSource();
        _timer = new PeriodicTimer(TimeSpan.FromSeconds(AutoRefreshSeconds));
        var ct = _timerCts.Token;
        try
        {
            while (await _timer.WaitForNextTickAsync(ct))
                await InvokeAsync(() => ReloadAsync(fit: false));
        }
        catch (OperationCanceledException)
        {
            // Stopped via toggle or dispose
        }
    }

    private void StopTimer()
    {
        _timerCts?.Cancel();
        _timerCts?.Dispose();
        _timerCts = null;
        _timer?.Dispose();
        _timer = null;
    }

    private Task ReloadAsync() => ReloadAsync(fit: true);

    private async Task ReloadAsync(bool fit)
    {
        if (!_initialized || _loading) return;

        if (!TimeRange.TryParse(_rangeInput, out var span))
        {
            _status = "Invalid range";
            StateHasChanged();
            return;
        }

        _loading = true;
        _status  = "Loading…";
        StateHasChanged();

        var to   = DateTimeOffset.UtcNow;
        var from = to - span;

        try
        {
            var result = await JS.InvokeAsync<LoadResult>(
                "AviatorMap.loadData",
                from.ToString("O"),
                to.ToString("O"),
                fit);

            _status = result.AircraftCount == 0 && result.StationsCount == 0
                ? "No data for this range"
                : $"{result.AircraftCount} aircraft · {result.StationsCount} METAR stations";
        }
        catch (JSDisconnectedException)
        {
            return;
        }
        catch
        {
            _status = "Load failed";
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    public async ValueTask DisposeAsync()
    {
        StopTimer();
        if (!_initialized) return;
        try
        {
            await JS.InvokeVoidAsync("AviatorMap.destroy");
        }
        catch (JSDisconnectedException)
        {
            // Circuit already gone — nothing to clean up in the browser
        }
    }

    private sealed record LoadResult(int AircraftCount, int StationsCount);
}
