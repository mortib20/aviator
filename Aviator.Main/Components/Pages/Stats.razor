@page "/stats"
@implements IDisposable
@inject IDbContextFactory<AviatorDbContext> DbFactory
@inject ClientTime Clock

<PageTitle>Stats — Aviator</PageTitle>

<div class="d-flex flex-column h-100 overflow-auto">

    @* ── Header ──────────────────────────────────────────────── *@
    <div class="page-toolbar">
        <h6 class="mb-0 fw-semibold me-1">Statistics</h6>
        @if (_loading && _totalMessages == 0)
        {
            <span class="spinner-border spinner-border-sm text-secondary" role="status"></span>
        }
        else if (_lastUpdated != default)
        {
            <span class="text-secondary small" title="Last updated — refreshes every @RefreshSeconds s">
                <i class="bi bi-clock me-1"></i><LocalTime Value="_lastUpdated" />
            </span>
        }
        <button class="btn btn-sm btn-outline-secondary py-0 ms-auto" @onclick="RefreshAsync"
                disabled="@_loading" title="Refresh">
            <i class="bi bi-arrow-clockwise @(_loading ? "spin" : "")"></i>
        </button>
    </div>

    @if (_totalMessages == 0 && _loadFailed)
    {
        <div class="empty-state">
            <i class="bi bi-database-x display-4 mb-3 opacity-50"></i>
            <p class="mb-0">Database unavailable — retrying every @RefreshSeconds s.</p>
        </div>
    }
    else if (_totalMessages == 0 && _loading)
    {
        <div class="empty-state">
            <span class="spinner-border mb-3 opacity-50"></span>
            <p class="mb-0">Loading statistics…</p>
        </div>
    }
    else if (_totalMessages == 0 && !_loading)
    {
        <div class="empty-state">
            <i class="bi bi-database display-4 mb-3 opacity-50"></i>
            <p class="mb-0">No data in database yet.</p>
        </div>
    }
    else
    {
        <div class="p-3 d-flex flex-column gap-3">

            @* ── Summary cards ────────────────────────────────────── *@
            <div class="row g-2">
                <div class="col-6 col-md-3">
                    <div class="card stat-card border h-100">
                        <div class="card-body p-3">
                            <div class="text-secondary small mb-1">All Time</div>
                            <div class="stat-value text-accent">@_totalMessages.ToString("N0")</div>
                            <div class="stat-sub">messages</div>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="card stat-card border h-100">
                        <div class="card-body p-3">
                            <div class="text-secondary small mb-1">Last 24h</div>
                            <div class="stat-value text-success">@_last24hMessages.ToString("N0")</div>
                            <div class="stat-sub">messages</div>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="card stat-card border h-100">
                        <div class="card-body p-3">
                            <div class="text-secondary small mb-1">Last Hour</div>
                            <div class="stat-value text-purple">@_lastHourMessages.ToString("N0")</div>
                            <div class="stat-sub">messages</div>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="card stat-card border h-100">
                        <div class="card-body p-3">
                            <div class="text-secondary small mb-1">Aircraft</div>
                            <div class="stat-value text-orange">@_activeAircraft.ToString("N0")</div>
                            <div class="stat-sub">active 24h</div>
                        </div>
                    </div>
                </div>
            </div>

            @* ── Frame types + 24h activity ───────────────────────── *@
            <div class="row g-2">
                <div class="col-12 col-lg-5">
                    <div class="card stat-card border h-100">
                        <div class="card-body p-3">
                            <p class="section-title">Frame Type Distribution</p>
                            @foreach (var kvp in _byFrameType.OrderByDescending(x => x.Value))
                            {
                                var pct = _maxFrameCount > 0 ? (double)kvp.Value / _maxFrameCount * 100 : 0;
                                <div class="mb-2">
                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                        <span class="frame-badge-@kvp.Key.ToLower() rounded-1">@kvp.Key</span>
                                        <span class="text-secondary small">@kvp.Value.ToString("N0")</span>
                                    </div>
                                    <div class="meter">
                                        <div class="meter-fill frame-bar-@kvp.Key.ToLower()" style="width:@Pct(pct)%"></div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
                <div class="col-12 col-lg-7">
                    <div class="card stat-card border h-100">
                        <div class="card-body p-3">
                            <p class="section-title mb-3">Activity — Last 24 Hours</p>
                            <div class="d-flex align-items-end gap-px" style="height:80px">
                                @foreach (var (slot, count) in _hourlyActivity)
                                {
                                    var label = Clock.ToLocal(slot).ToString("HH:mm");
                                    var heightPct = _maxHourlyCount > 0
                                        ? (double)count / _maxHourlyCount * 100
                                        : 0;
                                    <div class="activity-slot" title="@label — @count.ToString("N0") msg@(count == 1 ? "" : "s")">
                                        <div class="activity-bar @(count == 0 ? "is-empty" : "")" style="height:@Pct(heightPct)%"></div>
                                    </div>
                                }
                            </div>
                            <div class="d-flex justify-content-between mt-1">
                                @if (_hourlyActivity.Count > 0)
                                {
                                    <span class="axis-label">@Clock.ToLocal(_hourlyActivity[0].Slot).ToString("HH:mm")</span>
                                    <span class="axis-label">@Clock.ToLocal(_hourlyActivity[12].Slot).ToString("HH:mm")</span>
                                    <span class="axis-label">Now</span>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            @* ── Top aircraft + Top channels ──────────────────────── *@
            <div class="row g-2">
                <div class="col-12 col-md-6">
                    <div class="card stat-card border h-100">
                        <div class="card-body p-3">
                            <p class="section-title">Top Aircraft — Last 24h</p>
                            @if (_topAircraft.Count == 0)
                            {
                                <p class="text-secondary small mb-0">No registration data yet.</p>
                            }
                            else
                            {
                                @foreach (var (reg, count) in _topAircraft)
                                {
                                    var pct = _topAircraft[0].Count > 0 ? (double)count / _topAircraft[0].Count * 100 : 0;
                                    <div class="rank-row">
                                        <a class="font-monospace small fw-semibold reg-link text-decoration-none rank-key"
                                           href="/aircraft/@Uri.EscapeDataString(reg)">@reg</a>
                                        <div class="meter flex-fill">
                                            <div class="meter-fill bg-accent" style="width:@Pct(pct)%"></div>
                                        </div>
                                        <span class="text-secondary small rank-count">@count.ToString("N0")</span>
                                    </div>
                                }
                            }
                        </div>
                    </div>
                </div>
                <div class="col-12 col-md-6">
                    <div class="card stat-card border h-100">
                        <div class="card-body p-3">
                            <p class="section-title">Top Channels</p>
                            @if (_topChannels.Count == 0)
                            {
                                <p class="text-secondary small mb-0">No channel data yet.</p>
                            }
                            else
                            {
                                @foreach (var (channel, count) in _topChannels)
                                {
                                    var pct = _topChannels[0].Count > 0 ? (double)count / _topChannels[0].Count * 100 : 0;
                                    <div class="rank-row">
                                        <span class="small text-info font-monospace rank-key rank-key-wide">@ChannelFormat.Mhz(channel)</span>
                                        <div class="meter flex-fill">
                                            <div class="meter-fill frame-bar-vdl2" style="width:@Pct(pct)%"></div>
                                        </div>
                                        <span class="text-secondary small rank-count">@count.ToString("N0")</span>
                                    </div>
                                }
                            }
                        </div>
                    </div>
                </div>
            </div>

            @* ── Signal quality ───────────────────────────────────── *@
            @if (_avgSignalLevel.HasValue)
            {
                <div class="card stat-card border">
                    <div class="card-body p-3">
                        <p class="section-title mb-3">Signal Quality (All Time)</p>
                        <div class="row g-3 text-center">
                            <div class="col-4">
                                <div class="text-secondary small mb-1">Average</div>
                                <div class="fw-semibold">@_avgSignalLevel.Value.ToString("F1") dB</div>
                            </div>
                            <div class="col-4">
                                <div class="text-secondary small mb-1">Best</div>
                                <div class="fw-semibold text-success">@_maxSignalLevel?.ToString("F1") dB</div>
                            </div>
                            <div class="col-4">
                                <div class="text-secondary small mb-1">Worst</div>
                                <div class="fw-semibold text-warning">@_minSignalLevel?.ToString("F1") dB</div>
                            </div>
                        </div>
                    </div>
                </div>
            }

        </div>
    }
</div>

@code {
    private bool _loading = true;
    private bool _loadFailed;
    private DateTimeOffset _lastUpdated;

    private int _totalMessages;
    private int _last24hMessages;
    private int _lastHourMessages;
    private int _activeAircraft;

    private Dictionary<string, int> _byFrameType = new();
    private int _maxFrameCount = 1;

    private List<(DateTimeOffset Slot, int Count)> _hourlyActivity = [];
    private int _maxHourlyCount = 1;

    private List<(string Registration, int Count)> _topAircraft = [];
    private List<(string Channel, int Count)> _topChannels = [];

    private double? _avgSignalLevel;
    private double? _minSignalLevel;
    private double? _maxSignalLevel;

    private const int RefreshSeconds = 30;
    private readonly CancellationTokenSource _cts = new();

    protected override async Task OnInitializedAsync()
    {
        Clock.Changed += OnClockChanged;
        await RefreshAsync();
    }

    private void OnClockChanged() => InvokeAsync(StateHasChanged);

    protected override void OnAfterRender(bool firstRender)
    {
        // Only the interactive instance polls — not the prerender pass
        if (firstRender) _ = PollAsync(_cts.Token);
    }

    private async Task PollAsync(CancellationToken ct)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(RefreshSeconds));
        try
        {
            while (await timer.WaitForNextTickAsync(ct))
                await InvokeAsync(RefreshAsync);
        }
        catch (OperationCanceledException)
        {
            // Disposed
        }
    }

    private static string Pct(double value) =>
        value.ToString("F1", System.Globalization.CultureInfo.InvariantCulture);

    private async Task RefreshAsync()
    {
        if (_cts.IsCancellationRequested) return;
        _loading = true;
        StateHasChanged();

        try
        {
            await LoadStatsAsync(_cts.Token);
            _lastUpdated = DateTimeOffset.UtcNow;
            _loadFailed = false;
        }
        catch (OperationCanceledException)
        {
            return;
        }
        catch
        {
            // DB temporarily unavailable — keep last data, next refresh retries
            _loadFailed = true;
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private async Task LoadStatsAsync(CancellationToken ct)
    {
        await using var db = await DbFactory.CreateDbContextAsync(ct);

        var now = DateTimeOffset.UtcNow;
        var cutoff24h = now.AddHours(-24);
        var cutoff1h  = now.AddHours(-1);

        _totalMessages    = await db.Airframes.CountAsync(ct);
        _last24hMessages  = await db.Airframes.CountAsync(x => x.Timestamp >= cutoff24h, ct);
        _lastHourMessages = await db.Airframes.CountAsync(x => x.Timestamp >= cutoff1h, ct);
        _activeAircraft   = await db.Airframes
            .Where(x => x.Timestamp >= cutoff24h
                     && x.AcarsRegistration != null
                     && x.AcarsRegistration != "")
            .Select(x => x.AcarsRegistration)
            .Distinct()
            .CountAsync(ct);

        // Frame type breakdown
        var frameGroups = await db.Airframes
            .GroupBy(x => x.FrameType)
            .Select(g => new { Type = g.Key, Count = g.Count() })
            .ToListAsync(ct);
        _byFrameType   = frameGroups.ToDictionary(x => x.Type, x => x.Count);
        _maxFrameCount = _byFrameType.Values.DefaultIfEmpty(1).Max();

        // Hourly activity — bucket in the database (0 = the hour ending now)
        var buckets = await db.Database
            .SqlQuery<HourBucket>($"""
                SELECT floor(extract(epoch FROM ({now} - "Timestamp")) / 3600)::int AS "Bucket",
                       count(*)::int AS "Count"
                FROM airframes
                WHERE "Timestamp" >= {cutoff24h}
                GROUP BY 1
                """)
            .ToDictionaryAsync(b => b.Bucket, b => b.Count, ct);

        var hourlyActivity = new List<(DateTimeOffset Slot, int Count)>(24);
        for (int i = 23; i >= 0; i--)
            hourlyActivity.Add((now.AddHours(-i - 1), buckets.GetValueOrDefault(i)));
        _hourlyActivity  = hourlyActivity;
        _maxHourlyCount  = hourlyActivity.Max(x => x.Count) is > 0 and var m ? m : 1;

        // Top aircraft (last 24h by registration)
        _topAircraft = (await db.Airframes
            .Where(x => x.Timestamp >= cutoff24h
                     && x.AcarsRegistration != null
                     && x.AcarsRegistration != "")
            .GroupBy(x => x.AcarsRegistration!)
            .Select(g => new { Reg = g.Key, Count = g.Count() })
            .OrderByDescending(x => x.Count)
            .Take(10)
            .ToListAsync(ct))
            .Select(x => (x.Reg, x.Count))
            .ToList();

        // Top channels (all time)
        _topChannels = (await db.Airframes
            .Where(x => x.Channel != null && x.Channel != "")
            .GroupBy(x => x.Channel)
            .Select(g => new { Channel = g.Key, Count = g.Count() })
            .OrderByDescending(x => x.Count)
            .Take(8)
            .ToListAsync(ct))
            .Select(x => (x.Channel, x.Count))
            .ToList();

        // Signal quality — one round-trip instead of four
        var signal = await db.Airframes
            .Where(x => x.SignalLevel.HasValue)
            .GroupBy(_ => 1)
            .Select(g => new
            {
                Avg = g.Average(x => x.SignalLevel!.Value),
                Min = g.Min(x => x.SignalLevel!.Value),
                Max = g.Max(x => x.SignalLevel!.Value)
            })
            .FirstOrDefaultAsync(ct);
        _avgSignalLevel = signal?.Avg;
        _minSignalLevel = signal?.Min;
        _maxSignalLevel = signal?.Max;
    }

    private sealed record HourBucket(int Bucket, int Count);

    public void Dispose()
    {
        Clock.Changed -= OnClockChanged;
        _cts.Cancel();
        _cts.Dispose();
    }
}
