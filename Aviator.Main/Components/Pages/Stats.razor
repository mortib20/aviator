@page "/stats"
@implements IAsyncDisposable
@inject IDbContextFactory<AviatorDbContext> DbFactory

<PageTitle>Stats — Aviator</PageTitle>

<div class="d-flex flex-column h-100 overflow-auto">

    @* ── Header ──────────────────────────────────────────────── *@
    <div class="d-flex flex-wrap align-items-center gap-2 px-3 py-2 border-bottom border-secondary-subtle stats-header-actions">
        <h6 class="mb-0 fw-semibold me-1">Statistics</h6>
        @if (_loading && _totalMessages == 0)
        {
            <span class="spinner-border spinner-border-sm text-secondary" role="status"></span>
        }
        else if (_lastUpdated != default)
        {
            <span class="text-secondary small">
                <i class="bi bi-clock me-1"></i>@_lastUpdated.ToLocalTime().ToString("HH:mm:ss")
            </span>
        }
        <button class="btn btn-sm btn-outline-secondary py-0 ms-auto" @onclick="RefreshAsync"
                disabled="@_loading" title="Refresh">
            <i class="bi bi-arrow-clockwise @(_loading ? "spin" : "")"></i>
        </button>
    </div>

    @if (_totalMessages == 0 && _loading)
    {
        <div class="d-flex flex-column align-items-center justify-content-center h-100 text-secondary">
            <span class="spinner-border mb-3 opacity-50"></span>
            <p class="mb-0">Loading statistics…</p>
        </div>
    }
    else if (_totalMessages == 0 && !_loading)
    {
        <div class="d-flex flex-column align-items-center justify-content-center h-100 text-secondary">
            <i class="bi bi-database display-4 mb-3 opacity-50"></i>
            <p class="mb-0">No data in database yet.</p>
        </div>
    }
    else
    {
        <div class="p-3 d-flex flex-column gap-3">

            @* ── Summary cards ────────────────────────────────────── *@
            <div class="row g-2">
                <div class="col-6 col-md-3">
                    <div class="card stat-card border h-100">
                        <div class="card-body p-3">
                            <div class="text-secondary small mb-1">All Time</div>
                            <div class="fs-4 fw-bold" style="color:#58a6ff">@_totalMessages.ToString("N0")</div>
                            <div class="text-secondary" style="font-size:.72rem">messages</div>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="card stat-card border h-100">
                        <div class="card-body p-3">
                            <div class="text-secondary small mb-1">Last 24h</div>
                            <div class="fs-4 fw-bold text-success">@_last24hMessages.ToString("N0")</div>
                            <div class="text-secondary" style="font-size:.72rem">messages</div>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="card stat-card border h-100">
                        <div class="card-body p-3">
                            <div class="text-secondary small mb-1">Last Hour</div>
                            <div class="fs-4 fw-bold" style="color:#a371f7">@_lastHourMessages.ToString("N0")</div>
                            <div class="text-secondary" style="font-size:.72rem">messages</div>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="card stat-card border h-100">
                        <div class="card-body p-3">
                            <div class="text-secondary small mb-1">Aircraft</div>
                            <div class="fs-4 fw-bold" style="color:#db6d28">@_activeAircraft.ToString("N0")</div>
                            <div class="text-secondary" style="font-size:.72rem">active 24h</div>
                        </div>
                    </div>
                </div>
            </div>

            @* ── Frame types + 24h activity ───────────────────────── *@
            <div class="row g-2">
                <div class="col-12 col-lg-5">
                    <div class="card stat-card border h-100">
                        <div class="card-body p-3">
                            <p class="text-secondary fw-semibold mb-2" style="font-size:.7rem;letter-spacing:.08em;text-transform:uppercase">Frame Type Distribution</p>
                            @foreach (var kvp in _byFrameType.OrderByDescending(x => x.Value))
                            {
                                var pct = _maxFrameCount > 0 ? (double)kvp.Value / _maxFrameCount * 100 : 0;
                                <div class="mb-2">
                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                        <span class="frame-badge-@kvp.Key.ToLower() rounded-1">@kvp.Key</span>
                                        <span class="text-secondary small">@kvp.Value.ToString("N0")</span>
                                    </div>
                                    <div class="rounded" style="height:5px;background:#21262d;overflow:hidden">
                                        <div class="frame-bar-@kvp.Key.ToLower() h-100 rounded"
                                             style="width:@pct.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)%;transition:width .4s ease"></div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
                <div class="col-12 col-lg-7">
                    <div class="card stat-card border h-100">
                        <div class="card-body p-3">
                            <p class="text-secondary fw-semibold mb-3" style="font-size:.7rem;letter-spacing:.08em;text-transform:uppercase">Activity — Last 24 Hours</p>
                            <div class="d-flex align-items-end gap-px" style="height:80px">
                                @foreach (var (label, count) in _hourlyActivity)
                                {
                                    var heightPct = _maxHourlyCount > 0
                                        ? (double)count / _maxHourlyCount * 100
                                        : 0;
                                    <div class="flex-fill" style="height:100%;display:flex;align-items:flex-end" title="@label — @count msg@(count == 1 ? "" : "s")">
                                        <div class="activity-bar w-100"
                                             style="height:@heightPct.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)%;@(count == 0 ? "min-height:0" : "")"></div>
                                    </div>
                                }
                            </div>
                            <div class="d-flex justify-content-between mt-1">
                                @if (_hourlyActivity.Count > 0)
                                {
                                    <span class="text-secondary" style="font-size:.65rem">@_hourlyActivity[0].Label</span>
                                    <span class="text-secondary" style="font-size:.65rem">Now</span>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            @* ── Top aircraft + Top channels ──────────────────────── *@
            <div class="row g-2">
                <div class="col-12 col-md-6">
                    <div class="card stat-card border h-100">
                        <div class="card-body p-3">
                            <p class="text-secondary fw-semibold mb-2" style="font-size:.7rem;letter-spacing:.08em;text-transform:uppercase">Top Aircraft — Last 24h</p>
                            @if (_topAircraft.Count == 0)
                            {
                                <p class="text-secondary small mb-0">No registration data yet.</p>
                            }
                            else
                            {
                                @foreach (var (reg, count) in _topAircraft)
                                {
                                    var pct = _topAircraft[0].Count > 0 ? (double)count / _topAircraft[0].Count * 100 : 0;
                                    <div class="d-flex align-items-center gap-2 py-1 border-bottom border-secondary-subtle" style="border-bottom-style:dashed!important">
                                        <span class="font-monospace small fw-semibold" style="min-width:5rem">@reg</span>
                                        <div class="flex-fill rounded" style="height:4px;background:#21262d;overflow:hidden">
                                            <div style="width:@pct.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)%;height:100%;background:#58a6ff;border-radius:2px"></div>
                                        </div>
                                        <span class="text-secondary small" style="min-width:2rem;text-align:right">@count</span>
                                    </div>
                                }
                            }
                        </div>
                    </div>
                </div>
                <div class="col-12 col-md-6">
                    <div class="card stat-card border h-100">
                        <div class="card-body p-3">
                            <p class="text-secondary fw-semibold mb-2" style="font-size:.7rem;letter-spacing:.08em;text-transform:uppercase">Top Channels</p>
                            @if (_topChannels.Count == 0)
                            {
                                <p class="text-secondary small mb-0">No channel data yet.</p>
                            }
                            else
                            {
                                @foreach (var (channel, count) in _topChannels)
                                {
                                    var pct = _topChannels[0].Count > 0 ? (double)count / _topChannels[0].Count * 100 : 0;
                                    <div class="d-flex align-items-center gap-2 py-1 border-bottom border-secondary-subtle" style="border-bottom-style:dashed!important">
                                        <span class="small text-info font-monospace" style="min-width:6rem">@channel MHz</span>
                                        <div class="flex-fill rounded" style="height:4px;background:#21262d;overflow:hidden">
                                            <div style="width:@pct.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)%;height:100%;background:#1f6feb;border-radius:2px"></div>
                                        </div>
                                        <span class="text-secondary small" style="min-width:2.5rem;text-align:right">@count.ToString("N0")</span>
                                    </div>
                                }
                            }
                        </div>
                    </div>
                </div>
            </div>

            @* ── Signal quality ───────────────────────────────────── *@
            @if (_avgSignalLevel.HasValue)
            {
                <div class="card stat-card border">
                    <div class="card-body p-3">
                        <p class="text-secondary fw-semibold mb-3" style="font-size:.7rem;letter-spacing:.08em;text-transform:uppercase">Signal Quality (All Time)</p>
                        <div class="row g-3 text-center">
                            <div class="col-4">
                                <div class="text-secondary small mb-1">Average</div>
                                <div class="fw-semibold">@_avgSignalLevel.Value.ToString("F1") dB</div>
                            </div>
                            <div class="col-4">
                                <div class="text-secondary small mb-1">Best</div>
                                <div class="fw-semibold text-success">@_maxSignalLevel?.ToString("F1") dB</div>
                            </div>
                            <div class="col-4">
                                <div class="text-secondary small mb-1">Worst</div>
                                <div class="fw-semibold text-warning">@_minSignalLevel?.ToString("F1") dB</div>
                            </div>
                        </div>
                    </div>
                </div>
            }

        </div>
    }
</div>

@code {
    private bool _loading = true;
    private DateTimeOffset _lastUpdated;

    private int _totalMessages;
    private int _last24hMessages;
    private int _lastHourMessages;
    private int _activeAircraft;

    private Dictionary<string, int> _byFrameType = new();
    private int _maxFrameCount = 1;

    private List<(string Label, int Count)> _hourlyActivity = [];
    private int _maxHourlyCount = 1;

    private List<(string Registration, int Count)> _topAircraft = [];
    private List<(string Channel, int Count)> _topChannels = [];

    private double? _avgSignalLevel;
    private double? _minSignalLevel;
    private double? _maxSignalLevel;

    private System.Timers.Timer? _refreshTimer;

    protected override async Task OnInitializedAsync()
    {
        await RefreshAsync();

        _refreshTimer = new System.Timers.Timer(TimeSpan.FromSeconds(30));
        _refreshTimer.Elapsed += (_, _) => _ = InvokeAsync(RefreshAsync);
        _refreshTimer.AutoReset = true;
        _refreshTimer.Start();
    }

    private async Task RefreshAsync()
    {
        _loading = true;
        StateHasChanged();

        try
        {
            await LoadStatsAsync();
            _lastUpdated = DateTimeOffset.UtcNow;
        }
        catch
        {
            // DB temporarily unavailable — keep last data, next refresh retries
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private async Task LoadStatsAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();

        var now = DateTimeOffset.UtcNow;
        var cutoff24h = now.AddHours(-24);
        var cutoff1h  = now.AddHours(-1);

        _totalMessages    = await db.Airframes.CountAsync();
        _last24hMessages  = await db.Airframes.CountAsync(x => x.Timestamp >= cutoff24h);
        _lastHourMessages = await db.Airframes.CountAsync(x => x.Timestamp >= cutoff1h);
        _activeAircraft   = await db.Airframes
            .Where(x => x.Timestamp >= cutoff24h
                     && x.AcarsRegistration != null
                     && x.AcarsRegistration != "")
            .Select(x => x.AcarsRegistration)
            .Distinct()
            .CountAsync();

        // Frame type breakdown
        var frameGroups = await db.Airframes
            .GroupBy(x => x.FrameType)
            .Select(g => new { Type = g.Key, Count = g.Count() })
            .ToListAsync();
        _byFrameType   = frameGroups.ToDictionary(x => x.Type, x => x.Count);
        _maxFrameCount = _byFrameType.Values.DefaultIfEmpty(1).Max();

        // Hourly activity — pull only timestamps for last 24h, bucket in memory
        var recentTs = await db.Airframes
            .Where(x => x.Timestamp >= cutoff24h)
            .Select(x => x.Timestamp)
            .ToListAsync();

        var hourlyActivity = new List<(string Label, int Count)>(24);
        for (int i = 23; i >= 0; i--)
        {
            var slotStart = now.AddHours(-i - 1);
            var slotEnd   = now.AddHours(-i);
            var cnt = recentTs.Count(t => t >= slotStart && t < slotEnd);
            hourlyActivity.Add((slotStart.ToLocalTime().ToString("HH:mm"), cnt));
        }
        _hourlyActivity  = hourlyActivity;
        _maxHourlyCount  = hourlyActivity.Max(x => x.Count) is > 0 and var m ? m : 1;

        // Top aircraft (last 24h by registration)
        _topAircraft = (await db.Airframes
            .Where(x => x.Timestamp >= cutoff24h
                     && x.AcarsRegistration != null
                     && x.AcarsRegistration != "")
            .GroupBy(x => x.AcarsRegistration!)
            .Select(g => new { Reg = g.Key, Count = g.Count() })
            .OrderByDescending(x => x.Count)
            .Take(10)
            .ToListAsync())
            .Select(x => (x.Reg, x.Count))
            .ToList();

        // Top channels (all time)
        _topChannels = (await db.Airframes
            .Where(x => x.Channel != null && x.Channel != "")
            .GroupBy(x => x.Channel)
            .Select(g => new { Channel = g.Key, Count = g.Count() })
            .OrderByDescending(x => x.Count)
            .Take(8)
            .ToListAsync())
            .Select(x => (x.Channel, x.Count))
            .ToList();

        // Signal quality
        if (await db.Airframes.AnyAsync(x => x.SignalLevel.HasValue))
        {
            var withSignal = db.Airframes.Where(x => x.SignalLevel.HasValue);
            _avgSignalLevel = await withSignal.AverageAsync(x => x.SignalLevel!.Value);
            _minSignalLevel = await withSignal.MinAsync(x => x.SignalLevel!.Value);
            _maxSignalLevel = await withSignal.MaxAsync(x => x.SignalLevel!.Value);
        }
    }

    public ValueTask DisposeAsync()
    {
        _refreshTimer?.Dispose();
        return ValueTask.CompletedTask;
    }
}
