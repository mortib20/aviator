@page "/acars"
@implements IDisposable
@inject AirframeFeed Feed
@inject IJSRuntime JS

<PageTitle>ACARS — Aviator</PageTitle>

@{ var visible = _messages.Where(Matches).ToList(); }

<div class="d-flex flex-column h-100">

    @* ── Header ──────────────────────────────────────────────── *@
    <div class="page-toolbar">
        <h6 class="mb-0 fw-semibold me-1">ACARS</h6>
        <span class="badge rounded-pill @(_paused ? "bg-warning text-dark" : _subscribed ? "bg-success" : "bg-secondary")">
            <i class="bi @(_paused ? "bi-pause-fill" : "bi-circle-fill live-dot") me-1"></i>
            @(_paused ? "Paused" : _subscribed ? "Live" : "Starting…")
        </span>

        @* Frame-type chips double as filters — click to hide/show a type *@
        @foreach (var (type, count) in _totalCounts.OrderByDescending(x => x.Value))
        {
            var hidden = _hiddenTypes.Contains(type);
            <button type="button"
                    class="frame-chip frame-badge-@type.ToString().ToLowerInvariant() @(hidden ? "is-off" : "")"
                    aria-pressed="@((!hidden).ToString().ToLowerInvariant())"
                    title="@(hidden ? "Show" : "Hide") @type"
                    @onclick="() => ToggleType(type)">
                @type <span class="opacity-75">@count.ToString("N0")</span>
            </button>
        }

        <div class="ms-auto d-flex align-items-center gap-2 toolbar-end">
            <div class="input-group input-group-sm toolbar-search">
                <span class="input-group-text"><i class="bi bi-search"></i></span>
                <input type="search" class="form-control" placeholder="Reg, flight, label, text…"
                       aria-label="Filter messages"
                       @bind="_search" @bind:event="oninput" />
            </div>
            <span class="text-secondary small text-nowrap" title="Shown / buffered">
                @visible.Count / @_messages.Count
            </span>
            <button class="btn btn-sm btn-outline-secondary py-0" @onclick="TogglePause"
                    title="@(_paused ? "Resume" : "Pause") live feed">
                <i class="bi @(_paused ? "bi-play-fill" : "bi-pause-fill")"></i>
            </button>
            <button class="btn btn-sm btn-outline-secondary py-0" @onclick="ClearMessages"
                    title="Clear messages" disabled="@(_messages.Count == 0)">
                <i class="bi bi-trash"></i>
            </button>
        </div>
    </div>

    @* ── Pending banner ───────────────────────────────────────── *@
    @if (_pendingMessages.Count > 0)
    {
        <button type="button" class="pending-banner" @onclick="FlushPendingAndScrollToTop">
            <i class="bi bi-arrow-up-circle me-1"></i>
            @_pendingMessages.Count new message@(_pendingMessages.Count == 1 ? "" : "s") — click to show
        </button>
    }

    @* ── Message list ─────────────────────────────────────────── *@
    <div class="flex-grow-1 overflow-auto p-3" @ref="_scrollContainer" @onscroll="HandleScroll">
        @if (_messages.Count == 0)
        {
            <div class="empty-state">
                <i class="bi bi-reception-4 display-4 mb-3 text-success opacity-50"></i>
                <p class="mb-0">Waiting for messages…</p>
            </div>
        }
        else
        {
            <div class="d-flex flex-column gap-2">
                @foreach (var msg in visible)
                {
                    <AcarsCard @key="msg" Message="msg" />
                }
            </div>
            @if (visible.Count == 0)
            {
                <div class="empty-state">
                    <i class="bi bi-funnel display-4 mb-3 opacity-50"></i>
                    <p class="mb-2">No buffered message matches the filter.</p>
                    <button class="btn btn-sm btn-outline-secondary" @onclick="ResetFilter">Reset filter</button>
                </div>
            }
        }
    </div>

</div>

@code {
    private bool _subscribed;
    private bool _disposed;
    private bool _paused;

    private readonly List<Airframe> _messages = [];
    private readonly Queue<Airframe> _pendingMessages = new();
    private readonly Dictionary<FrameType, int> _totalCounts = [];
    private readonly HashSet<FrameType> _hiddenTypes = [];
    private string _search = "";

    private const int MaxMessages = 200;
    private const int MaxPending  = 500;
    // Coalesce renders when frames arrive in bursts
    private static readonly TimeSpan RenderInterval = TimeSpan.FromMilliseconds(250);
    private bool _renderScheduled;

    private bool _isAtTop = true;
    private bool _scrollHandling;
    private ElementReference _scrollContainer;

    // Subscribe only once interactive — a prerender pass would otherwise receive frames too
    protected override void OnAfterRender(bool firstRender)
    {
        if (!firstRender) return;
        Feed.Received += OnFrame;
        _subscribed = true;
        StateHasChanged();
    }

    // Called on the input thread — marshal onto the renderer's sync context
    private void OnFrame(Airframe frame)
    {
        if (_disposed) return;
        _ = InvokeAsync(() =>
        {
            _totalCounts[frame.FrameType] = _totalCounts.GetValueOrDefault(frame.FrameType) + 1;

            if (_isAtTop && !_paused)
            {
                if (_messages.Count >= MaxMessages)
                    _messages.RemoveAt(_messages.Count - 1);
                _messages.Insert(0, frame);
            }
            else if (_pendingMessages.Count < MaxPending)
            {
                _pendingMessages.Enqueue(frame);
            }

            ScheduleRender();
        });
    }

    private void ScheduleRender()
    {
        if (_renderScheduled) return;
        _renderScheduled = true;
        _ = Task.Delay(RenderInterval).ContinueWith(_ => InvokeAsync(() =>
        {
            _renderScheduled = false;
            if (!_disposed) StateHasChanged();
        }), TaskScheduler.Default);
    }

    private bool Matches(Airframe frame)
    {
        if (_hiddenTypes.Contains(frame.FrameType)) return false;
        if (string.IsNullOrWhiteSpace(_search)) return true;

        var term = _search.Trim();
        var acars = frame.Protocol as Aviator.Airframe.Frames.Entities.Acars;
        return Has(acars?.Registration) || Has(acars?.FlightNumber) || Has(acars?.Label)
            || Has(acars?.Text) || Has(frame.Icao) || Has(frame.Channel);

        bool Has(string? value) => value?.Contains(term, StringComparison.OrdinalIgnoreCase) == true;
    }

    private void ToggleType(FrameType type)
    {
        if (!_hiddenTypes.Remove(type)) _hiddenTypes.Add(type);
    }

    private void ResetFilter()
    {
        _hiddenTypes.Clear();
        _search = "";
    }

    private void TogglePause()
    {
        _paused = !_paused;
        if (!_paused && _isAtTop) FlushPending();
    }

    // Debounced via _scrollHandling flag — only one in-flight JS call at a time
    private async Task HandleScroll()
    {
        if (_scrollHandling) return;
        _scrollHandling = true;
        try
        {
            var atTop = await JS.InvokeAsync<bool>("isAtTop", _scrollContainer);
            if (atTop == _isAtTop) return;
            _isAtTop = atTop;
            if (_isAtTop && !_paused && _pendingMessages.Count > 0)
                FlushPending();
        }
        catch (JSDisconnectedException)
        {
            // Circuit gone
        }
        finally
        {
            _scrollHandling = false;
        }
    }

    private void FlushPending()
    {
        // Enqueued oldest-first; insert at 0 so newest lands at top
        while (_pendingMessages.TryDequeue(out var msg))
            _messages.Insert(0, msg);
        if (_messages.Count > MaxMessages)
            _messages.RemoveRange(MaxMessages, _messages.Count - MaxMessages);
    }

    private async Task FlushPendingAndScrollToTop()
    {
        _paused = false;
        FlushPending();
        _isAtTop = true;
        await JS.InvokeVoidAsync("scrollToTop", _scrollContainer);
    }

    private void ClearMessages()
    {
        _messages.Clear();
        _pendingMessages.Clear();
    }

    public void Dispose()
    {
        _disposed = true;
        Feed.Received -= OnFrame;
    }
}
