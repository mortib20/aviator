@inject IOptions<FrontendConfig> Config
@inject NavigationManager Nav
@implements IDisposable

<nav class="navbar navbar-expand-lg border-bottom border-secondary-subtle px-3">
    <a class="navbar-brand d-flex align-items-center gap-2 fw-semibold" href="/">
        <i class="bi bi-airplane-engines-fill text-primary"></i>
        Aviator
    </a>
    <button class="navbar-toggler" type="button" @onclick="ToggleMenu"
            aria-controls="navbarContent" aria-expanded="@_expanded.ToString().ToLower()" aria-label="Toggle navigation">
        <span class="navbar-toggler-icon"></span>
    </button>
    <div class="navbar-collapse @(_expanded ? "show" : "collapse")" id="navbarContent">
        <ul class="navbar-nav me-auto mb-2 mb-lg-0">
            <li class="nav-item">
                <NavLink class="nav-link" href="/" Match="NavLinkMatch.All">
                    <i class="bi bi-house me-1"></i>Home
                </NavLink>
            </li>
            <li class="nav-item">
                <NavLink class="nav-link" href="/acars">
                    <i class="bi bi-broadcast me-1"></i>ACARS
                </NavLink>
            </li>
            <li class="nav-item">
                <NavLink class="nav-link" href="/stats">
                    <i class="bi bi-bar-chart-line me-1"></i>Stats
                </NavLink>
            </li>
            <li class="nav-item">
                <NavLink class="nav-link" href="/map">
                    <i class="bi bi-map me-1"></i>Map
                </NavLink>
            </li>
        </ul>

        <form class="nav-search me-lg-3 mb-2 mb-lg-0" role="search" @onsubmit="Search">
            <div class="input-group input-group-sm">
                <span class="input-group-text"><i class="bi bi-airplane"></i></span>
                <input class="form-control" type="search" placeholder="Registration…"
                       aria-label="Go to aircraft by registration"
                       autocapitalize="characters" spellcheck="false"
                       @bind="_query" />
            </div>
        </form>

        @if (Config.Value.ExternalLinks.Count > 0)
        {
            <ul class="navbar-nav">
                @foreach (var link in Config.Value.ExternalLinks)
                {
                    <li class="nav-item">
                        <a class="nav-link d-flex align-items-center gap-1" href="@link.Url" target="_blank" rel="noopener noreferrer">
                            @if (link.Icon.StartsWith("bi-", StringComparison.Ordinal))
                            {
                                <i class="bi @link.Icon"></i>
                            }
                            else
                            {
                                <span class="material-icons nav-material-icon" aria-hidden="true">@link.Icon</span>
                            }
                            @link.Title
                            <i class="bi bi-box-arrow-up-right small opacity-50"></i>
                        </a>
                    </li>
                }
            </ul>
        }
    </div>
</nav>

@code {
    private bool _expanded = false;
    private string _query = "";

    protected override void OnInitialized()
    {
        Nav.LocationChanged += OnLocationChanged;
    }

    private void ToggleMenu() => _expanded = !_expanded;

    private void Search()
    {
        var reg = _query.Trim().ToUpperInvariant();
        if (reg.Length == 0) return;
        _query = "";
        Nav.NavigateTo($"/aircraft/{Uri.EscapeDataString(reg)}");
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        _expanded = false;
        InvokeAsync(StateHasChanged);
    }

    public void Dispose() => Nav.LocationChanged -= OnLocationChanged;
}
